{
  "name": "dsh-mail",
  "version": "0.1.0",
  "description": "Mail channel for DSH: one dedicated mailbox per machine, email as session entry, replies continue the session",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:single-process": "node --test-isolation=none --test test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "mail",
    "email",
    "imap",
    "smtp",
    "agent",
    "channel"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}
